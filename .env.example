# Copy to .env and change the passwords. .env is git-ignored.

# MinIO (raw landing zone)
MINIO_ROOT_USER=gitlytics
MINIO_ROOT_PASSWORD=change-me-minio-123
MINIO_ENDPOINT=localhost:9100
MINIO_BUCKET=gh-raw

# MongoDB (lab 3)
MONGO_ROOT_USER=gitlytics
MONGO_ROOT_PASSWORD=change-me-mongo-123
MONGO_HOST=localhost
MONGO_PORT=27018

# Hadoop
HDFS_ROOT=/gitlytics

# Airflow metadata database (Postgres container, host port 5433)
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change-me-airflow-123

# Hive metastore (database "metastore" in the same Postgres container)
HIVE_DB_USER=hive
HIVE_DB_PASSWORD=change-me-hive-123
